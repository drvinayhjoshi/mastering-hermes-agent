# Messaging settings for ~/.hermes/.env (Mastering Hermes Agent, Chapter 5, section 5.4)
# You normally do NOT edit these by hand: `hermes gateway setup` writes them.
# They are here so you can check what the wizard stored. Keep the real file private.
# Uncomment only the platforms you use. Allowlists are not optional.

# --- Telegram (5.4.1) ---
# TELEGRAM_BOT_TOKEN=YOUR_BOT_TOKEN
# TELEGRAM_ALLOWED_USERS=123456789

# --- WhatsApp bridge (5.4.2) ---
# WHATSAPP_ALLOWED_USERS=919876543210

# --- WhatsApp Business Cloud API (5.4.3) ---
# Run `hermes whatsapp-cloud`; it stores the access token, phone number ID,
# app secret and verify token itself.
# WHATSAPP_CLOUD_ALLOWED_USERS=919876543210,919812345678

# --- Slack (5.4.4) ---
# SLACK_BOT_TOKEN=xoxb-your-bot-token
# SLACK_APP_TOKEN=xapp-your-app-token
# SLACK_ALLOWED_USERS=U01ABC2DEF3

# --- Email (5.4.5) --- use a dedicated mailbox and an app password
# EMAIL_ADDRESS=assistant@yourbusiness.com
# EMAIL_PASSWORD=your-app-password
# EMAIL_IMAP_HOST=imap.gmail.com
# EMAIL_SMTP_HOST=smtp.gmail.com
# EMAIL_ALLOWED_USERS=you@yourbusiness.com
# EMAIL_HOME_ADDRESS=you@yourbusiness.com

# --- Google Chat (5.4.6) ---
# GOOGLE_CHAT_PROJECT_ID=acme
# GOOGLE_CHAT_SUBSCRIPTION_NAME=projects/acme/subscriptions/hermes-sub
# GOOGLE_CHAT_SERVICE_ACCOUNT_JSON=/home/you/.hermes/google-chat-sa.json
# GOOGLE_CHAT_ALLOWED_USERS=you@yourdomain.com

# --- Microsoft Teams (5.4.7) ---
# TEAMS_CLIENT_ID=YOUR_CLIENT_ID
# TEAMS_CLIENT_SECRET=YOUR_CLIENT_SECRET
# TEAMS_TENANT_ID=YOUR_TENANT_ID
# TEAMS_ALLOWED_USERS=YOUR_ENTRA_OBJECT_ID
